{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realtosim.invalid/schemas/npc.schema.json",
  "title": "NPC",
  "description": "퍼즐 장소에 등장하는 캐릭터 1명. 화면 연출용이며 에이전트 관측에는 넣지 않는다. 한 캐릭터가 여러 퍼즐에 등장할 수 있다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name"],
  "properties": {
    "id": { "$ref": "#/$defs/npcId" },
    "name": {
      "description": "화면에 보이는 이름.",
      "type": "string",
      "minLength": 1
    },
    "image": {
      "description": "캐릭터 이미지 경로. 이미지 작업은 후반에 하므로 지금은 선택이다.",
      "type": "string",
      "minLength": 1
    },
    "tone": {
      "description": "말투 (선택).",
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "npcId": {
      "description": "퍼즐과 로그에서 참조하는 식별자. 예: librarian",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    }
  }
}
