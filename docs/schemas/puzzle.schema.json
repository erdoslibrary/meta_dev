{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realtosim.invalid/schemas/puzzle.schema.json",
  "title": "Puzzle set",
  "description": "선형으로 이어지는 퍼즐 묶음 (spec §5.5). answer, next_instruction, next_object_id는 정답과 다음 장소를 드러내므로 해결 전 에이전트 관측에 넣지 않는다. npc, contains_hint, after_wrong, on_wrong, on_correct는 관측에 넣지 않는다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["puzzle_set_id", "space_id", "start_cell", "puzzles"],
  "properties": {
    "puzzle_set_id": { "type": "string", "minLength": 1 },
    "space_id": {
      "description": "이 퍼즐이 놓인 공간의 space_id.",
      "type": "string",
      "minLength": 1
    },
    "start_cell": {
      "description": "엔진과 고스트 재생의 시작 위치.",
      "$ref": "space.schema.json#/$defs/cellRef"
    },
    "start_instruction": {
      "description": "첫 장소 지시 (선택). 필요 여부는 퍼즐 선정 후 판단한다.",
      "type": "string",
      "minLength": 1
    },
    "puzzles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/puzzle" }
    }
  },
  "$defs": {
    "image": {
      "description": "퍼즐 그림만 가리킨다. 캐릭터 이미지는 npc로 분리한다. 안정적인 참조인 경로와 해시만 둔다. Files API의 file_id는 서버가 발급하므로 캐시 레지스트리에 둔다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": {
          "description": "소문자 hex 64자.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "dialogueLine": {
      "description": "NPC 대화 한 문장. 대화 속 단서는 문제의 일부이며 점수에 넣지 않는다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "contains_hint"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "contains_hint": {
          "description": "단서 포함 여부. 보고서의 reason 분석에만 쓴다.",
          "type": "boolean"
        }
      }
    },
    "hint": {
      "description": "텍스트 힌트. level은 표시용이며 순서를 보장하지 않는다. 힌트는 after_wrong으로만 열린다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "after_wrong", "text"],
      "properties": {
        "level": { "type": "integer", "minimum": 1 },
        "after_wrong": {
          "description": "오답 수가 이 값이 되면 열린다. 5번째 오답은 실패이므로 4까지만 쓴다.",
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "puzzle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "object_id",
        "npc",
        "dialogue",
        "image",
        "question",
        "answer",
        "answer_letter_count",
        "hints",
        "next_instruction",
        "next_object_id"
      ],
      "properties": {
        "number": {
          "description": "1부터 시작하는 순서. 로그 이벤트의 puzzle이 이 값을 가리킨다.",
          "type": "integer",
          "minimum": 1
        },
        "object_id": {
          "description": "퍼즐이 놓인 사물.",
          "$ref": "space.schema.json#/$defs/objectId"
        },
        "npc": {
          "description": "이 퍼즐에 등장하는 NPC의 id. 모든 퍼즐에 NPC가 있다.",
          "$ref": "npc.schema.json#/$defs/npcId"
        },
        "dialogue": {
          "description": "도착하면 보여 주는 NPC 대화.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/dialogueLine" }
        },
        "on_wrong": {
          "description": "오답일 때 NPC 반응 대사 (선택). 화면 연출 전용이며 에이전트 관측에 넣지 않는다.",
          "type": "string",
          "minLength": 1
        },
        "on_correct": {
          "description": "정답일 때 NPC 반응 대사 (선택). 화면 연출 전용이며 에이전트 관측에 넣지 않는다.",
          "type": "string",
          "minLength": 1
        },
        "image": { "$ref": "#/$defs/image" },
        "question": { "type": "string", "minLength": 1 },
        "answer": {
          "description": "정답. 실제 퍼즐을 보기 전이므로 빈 문자열만 금지한다. §7.4 정규화 결과와 같은지는 검증기가 확인한다.",
          "type": "string",
          "minLength": 1
        },
        "answer_letter_count": {
          "description": "에이전트에게 알려 주는 정답 글자 수. answer 길이와 같은지는 검증기가 확인한다.",
          "type": "integer",
          "minimum": 1
        },
        "max_attempts": {
          "description": "퍼즐당 시도 횟수. 5회 고정이며, 없으면 엔진이 5를 쓴다.",
          "const": 5,
          "default": 5
        },
        "hints": {
          "description": "배열로 두지만 현재는 퍼즐당 정확히 1개만 쓴다.",
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/hint" }
        },
        "next_instruction": {
          "description": "해결 후 받는 다음 장소 지시. 마지막 퍼즐은 null.",
          "type": ["string", "null"],
          "minLength": 1
        },
        "next_object_id": {
          "description": "지시문이 가리키는 사물. §6.1 연결 검사를 코드로 하기 위해 둔다. 마지막 퍼즐은 null.",
          "anyOf": [
            { "$ref": "space.schema.json#/$defs/objectId" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
