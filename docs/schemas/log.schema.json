{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realtosim.invalid/schemas/log.schema.json",
  "title": "Run log",
  "description": "실행 1회의 행동 로그 (spec §8). t의 증가와 마지막 이벤트가 end인지는 검증기 코드가 확인한다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "persona", "puzzle_set_id", "model", "events"],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^r[0-9]+$"
    },
    "persona": { "$ref": "persona.schema.json" },
    "puzzle_set_id": {
      "description": "어떤 퍼즐 묶음으로 나온 결과인지.",
      "type": "string",
      "minLength": 1
    },
    "model": {
      "description": "실행에 쓴 모델. 예: muse-spark-1.3",
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "description": "페르소나 추출을 재현하기 위한 시드 (선택).",
      "type": "integer"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/move" },
          { "$ref": "#/$defs/view" },
          { "$ref": "#/$defs/npc_dialogue" },
          { "$ref": "#/$defs/answer_submitted" },
          { "$ref": "#/$defs/hint_revealed" },
          { "$ref": "#/$defs/puzzle_ended" },
          { "$ref": "#/$defs/rejected" },
          { "$ref": "#/$defs/end" }
        ]
      }
    }
  },
  "$defs": {
    "eventBase": {
      "description": "모든 이벤트의 공통 필드.",
      "type": "object",
      "required": ["t", "puzzle", "type"],
      "properties": {
        "t": {
          "description": "1부터 증가하는 이벤트 순번.",
          "type": "integer",
          "minimum": 1
        },
        "puzzle": {
          "description": "이벤트 시점에 진행 중인 퍼즐의 number.",
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "description": "에이전트가 남긴 이유. answer_submitted에서만 필수.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "move": {
      "description": "칸 이동. 고스트 재생에 쓴다.",
      "allOf": [{ "$ref": "#/$defs/eventBase" }],
      "required": ["value"],
      "properties": {
        "type": { "const": "move" },
        "value": { "$ref": "space.schema.json#/$defs/cellRef" }
      },
      "unevaluatedProperties": false
    },
    "view": {
      "description": "사물 찍기. 사물 텍스트와 사진을 돌려주며, 맞닿은 현재 퍼즐의 사물이면 뒤이어 npc_dialogue가 남는다.",
      "allOf": [{ "$ref": "#/$defs/eventBase" }],
      "required": ["value"],
      "properties": {
        "type": { "const": "view" },
        "value": { "$ref": "space.schema.json#/$defs/objectId" }
      },
      "unevaluatedProperties": false
    },
    "npc_dialogue": {
      "description": "맞닿은 위치에서 현재 퍼즐의 사물을 찍어(도착) 엔진이 NPC 대화를 보여 줌.",
      "allOf": [{ "$ref": "#/$defs/eventBase" }],
      "required": ["npc"],
      "properties": {
        "type": { "const": "npc_dialogue" },
        "npc": { "$ref": "npc.schema.json#/$defs/npcId" }
      },
      "unevaluatedProperties": false
    },
    "answer_submitted": {
      "description": "답 입력. value는 입력 원문이고, correct는 상태 머신이 채운다.",
      "allOf": [{ "$ref": "#/$defs/eventBase" }],
      "required": ["value", "attempt", "correct", "reason"],
      "properties": {
        "type": { "const": "answer_submitted" },
        "value": { "type": "string" },
        "attempt": {
          "description": "이 퍼즐에서 몇 번째 시도인지. 거절된 입력은 세지 않는다.",
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "correct": { "type": "boolean" }
      },
      "unevaluatedProperties": false
    },
    "hint_revealed": {
      "description": "오답 수가 after_wrong에 닿아 엔진이 힌트를 염.",
      "allOf": [{ "$ref": "#/$defs/eventBase" }],
      "required": ["level"],
      "properties": {
        "type": { "const": "hint_revealed" },
        "level": { "type": "integer", "minimum": 1 }
      },
      "unevaluatedProperties": false
    },
    "puzzle_ended": {
      "description": "퍼즐 종료. 실행이 중간에 끊긴 퍼즐에는 남기지 않는다.",
      "allOf": [{ "$ref": "#/$defs/eventBase" }],
      "required": ["result", "attempts_used"],
      "properties": {
        "type": { "const": "puzzle_ended" },
        "result": {
          "description": "solved_by_dialogue: 힌트 없이 해결, solved_with_hint: 힌트가 열린 뒤 해결, failed: 5회 소진.",
          "enum": ["solved_by_dialogue", "solved_with_hint", "failed"]
        },
        "attempts_used": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      },
      "unevaluatedProperties": false
    },
    "rejected": {
      "description": "코드가 거절한 행동. 점수에 넣지 않는다.",
      "allOf": [{ "$ref": "#/$defs/eventBase" }],
      "required": ["attempted_action", "error"],
      "properties": {
        "type": { "const": "rejected" },
        "attempted_action": {
          "description": "에이전트가 시도한 행동. 형식 오류로 알 수 없으면 null.",
          "type": ["string", "null"]
        },
        "value": {
          "description": "에이전트가 보낸 값 원문 (선택).",
          "type": ["string", "null"]
        },
        "error": {
          "description": "코드가 돌려준 거절 이유.",
          "type": "string",
          "minLength": 1
        }
      },
      "unevaluatedProperties": false
    },
    "end": {
      "description": "실행 종료. 끝난 원인을 구분한다.",
      "allOf": [{ "$ref": "#/$defs/eventBase" }],
      "required": ["outcome"],
      "properties": {
        "type": { "const": "end" },
        "outcome": { "enum": ["completed", "action_limit", "api_error"] }
      },
      "unevaluatedProperties": false
    }
  }
}
